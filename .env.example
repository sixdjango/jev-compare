# TypeSafe AI API key (https://typesafe.ai)
JEV_KEY=

# Optional: HTTP proxy, for regions where the API is unavailable (HTTP 451).
# Node's fetch ignores proxy variables unless --use-env-proxy is set.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
# NODE_OPTIONS=--use-env-proxy
